{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "nvBlack": "#050a05",
    "nvBg": "#0a0f0a",
    "nvPanel": "#0e150d",
    "nvElement": "#141e12",
    "nvBorder": "#1e2e1b",
    "nvBorderActive": "#2a4225",
    "nvNeon": "#39ff14",
    "nvNeonDim": "#1bcc0e",
    "nvNeonHi": "#7aff5a",
    "nvCyan": "#00ffc8",
    "nvTeal": "#20f0b0",
    "nvPurple": "#b44aff",
    "nvOrange": "#ff8c1a",
    "nvRed": "#ff3333",
    "nvYellow": "#d4ff00",
    "nvBlue": "#00bbff",
    "nvGray": "#6a9a70",
    "nvGrayMuted": "#3a5a3e",
    "lightBg": "#eaf3e8",
    "lightPaper": "#dfe9dc",
    "lightInk1": "#d0dad2",
    "lightText": "#1a2e1c",
    "lightGray": "#5e7a62"
  },
  "theme": {
    "primary": { "dark": "nvNeon", "light": "nvNeonDim" },
    "secondary": { "dark": "nvCyan", "light": "nvTeal" },
    "accent": { "dark": "nvPurple", "light": "nvPurple" },
    "error": { "dark": "nvRed", "light": "nvRed" },
    "warning": { "dark": "nvYellow", "light": "nvYellow" },
    "success": { "dark": "nvNeonHi", "light": "nvNeonDim" },
    "info": { "dark": "nvBlue", "light": "nvBlue" },
    "text": { "dark": "nvNeonHi", "light": "lightText" },
    "textMuted": { "dark": "nvGray", "light": "lightGray" },
    "background": { "dark": "nvBlack", "light": "lightBg" },
    "backgroundPanel": { "dark": "nvBg", "light": "lightPaper" },
    "backgroundElement": { "dark": "nvPanel", "light": "lightInk1" },
    "border": { "dark": "nvBorder", "light": "lightGray" },
    "borderActive": { "dark": "nvNeon", "light": "nvNeonDim" },
    "borderSubtle": { "dark": "nvElement", "light": "lightInk1" },
    "diffAdded": { "dark": "nvNeonDim", "light": "nvNeonDim" },
    "diffRemoved": { "dark": "nvRed", "light": "nvRed" },
    "diffContext": { "dark": "nvGray", "light": "lightGray" },
    "diffHunkHeader": { "dark": "nvBlue", "light": "nvBlue" },
    "diffHighlightAdded": { "dark": "#88ff66", "light": "#4daa5e" },
    "diffHighlightRemoved": { "dark": "#ff6666", "light": "#cc3333" },
    "diffAddedBg": { "dark": "#0a1f0a", "light": "#d5eed5" },
    "diffRemovedBg": { "dark": "#1f0a0a", "light": "#f5d5d5" },
    "diffContextBg": { "dark": "nvBg", "light": "lightPaper" },
    "diffLineNumber": { "dark": "nvGrayMuted", "light": "#4a6a4e" },
    "diffAddedLineNumberBg": { "dark": "#071507", "light": "#c0ddc0" },
    "diffRemovedLineNumberBg": { "dark": "#150707", "light": "#eac0c0" },
    "markdownText": { "dark": "nvNeonHi", "light": "lightText" },
    "markdownHeading": { "dark": "nvCyan", "light": "nvTeal" },
    "markdownLink": { "dark": "nvBlue", "light": "nvBlue" },
    "markdownLinkText": { "dark": "nvTeal", "light": "nvTeal" },
    "markdownCode": { "dark": "nvNeonDim", "light": "nvNeonDim" },
    "markdownBlockQuote": { "dark": "nvGray", "light": "lightGray" },
    "markdownEmph": { "dark": "nvOrange", "light": "nvOrange" },
    "markdownStrong": { "dark": "nvYellow", "light": "nvYellow" },
    "markdownHorizontalRule": { "dark": "nvGrayMuted", "light": "lightGray" },
    "markdownListItem": { "dark": "nvBlue", "light": "nvBlue" },
    "markdownListEnumeration": { "dark": "nvTeal", "light": "nvTeal" },
    "markdownImage": { "dark": "nvBlue", "light": "nvBlue" },
    "markdownImageText": { "dark": "nvTeal", "light": "nvTeal" },
    "markdownCodeBlock": { "dark": "nvNeonHi", "light": "lightText" },
    "syntaxComment": { "dark": "nvGrayMuted", "light": "lightGray" },
    "syntaxKeyword": { "dark": "nvPurple", "light": "nvPurple" },
    "syntaxFunction": { "dark": "nvNeon", "light": "nvNeonDim" },
    "syntaxVariable": { "dark": "nvNeonHi", "light": "lightText" },
    "syntaxString": { "dark": "nvCyan", "light": "nvTeal" },
    "syntaxNumber": { "dark": "nvOrange", "light": "nvOrange" },
    "syntaxType": { "dark": "nvYellow", "light": "nvYellow" },
    "syntaxOperator": { "dark": "nvTeal", "light": "nvTeal" },
    "syntaxPunctuation": { "dark": "nvGray", "light": "lightText" }
  }
}
